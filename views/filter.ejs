<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Filter</title>
    <link rel="stylesheet" href="../src/styles/style.css">
</head>

<body>
    <form method="post">
        <input-group>
            <label for="views">Views</label>
            <input type="number" min="0" required name="views" id="viewsInput">
        </input-group>
        <input type="submit" value="Search">
    </form>

    <table>
        <tr>
            <th>Title</th>
            <th>Views</th>
        </tr>
        <tbody>
            <%wikiArticles.forEach((wikiArticle)=> {%>
                <tr>
                    <td><a href="<%=wikiArticle.url%>">
                            <%=wikiArticle.title%>
                        </a></td>
                    <td>
                        <p class=<%=wikiArticle.views> 1000 ? "bold-view" : ""%>><%=wikiArticle.views%>
                        </p>
                    </td>
                </tr>
                <%})%>
        </tbody>
    </table>

</body>

</html>