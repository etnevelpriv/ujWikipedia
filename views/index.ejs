<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Wiki Articles
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <table>
        <tr>
            <th>Title</th>
            <th>Views</th>
        </tr>
            <tbody>
        <%wikiArticles.forEach((wikiArticle)=> {%>
            <tr>
                <td><a href="<%=wikiArticle.url%>">
                        <%=wikiArticle.title%>
                    </a></td>
                <td>
                    <p class=<%=wikiArticle.views > 1000 ? "bold-view" : ""%>><%=wikiArticle.views%></p>
                </td>
            </tr>
            <%})%>
    </tbody>
    </table>
</body>

</html>